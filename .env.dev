# Development Environment Configuration
SPRING_PROFILE=dev

# Database - H2 en archivo para persistencia entre reinicios
DATABASE_URL=jdbc:h2:file:./data/taxi-service-db
DATABASE_DRIVER=org.h2.Driver
DATABASE_USERNAME=u
DATABASE_PASSWORD=u

# H2 Console
H2_CONSOLE_ENABLED=true

# SQL Initialization
SQL_INIT_MODE=always

# Server
SERVER_PORT=8080

# SQS - No usado en dev (usa InMemoryEventPublisher)
SQS_ENABLED=false
SQS_PROJECTIONS_ENDPOINT=

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_SQL=DEBUG
LOG_LEVEL_APP=DEBUG
