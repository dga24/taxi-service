# Production Environment Configuration
SPRING_PROFILE=prod

# Database
DATABASE_URL=jdbc:postgresql://your-database-host:5432/taxi_service
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_USERNAME=taxi_user
DATABASE_PASSWORD=CHANGE_ME_IN_PRODUCTION


H2_CONSOLE_ENABLED=false


SQL_INIT_MODE=never

# Server
SERVER_PORT=8080

# SQS - AWS SQS real o LocalStack
SQS_ENABLED=true
SQS_PROJECTIONS_ENDPOINT=https://sqs.us-east-1.amazonaws.com/123456789012/projections-queue

# AWS Credentials (si usas AWS SDK)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# Logging
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_SQL=INFO
LOG_LEVEL_APP=INFO
